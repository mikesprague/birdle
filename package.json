{
  "name": "birdle",
  "version": "1.24.1",
  "private": true,
  "description": "birdle",
  "keywords": [],
  "homepage": "https://birdle.app",
  "bugs": {
    "url": "https://github.com/mikesprague/birdle/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Michael Sprague",
    "email": "mikesprague@gmail.com"
  },
  "repository": {
    "url": "https://github.com/mikesprague/birdle"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "changelog": "conventional-changelog -p conventionalcommits -n changelog.config.js -i CHANGELOG.md -s && git add CHANGELOG.md",
    "changelog:preview": "conventional-changelog -p conventionalcommits -n changelog.config.js -u --stdout -i /dev/null",
    "clean": "rm -rf ./dist",
    "copy:charts-css": "cp node_modules/charts.css/dist/charts.min.css public/charts.min.css",
    "dev": "vite serve --port 3002",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "lint": "oxlint src",
    "start": "cross-env NODE_ENV=development npm run dev",
    "prebuild": "npm run clean && npm run copy:charts-css && npm install",
    "preview": "vite preview",
    "test": "npm run lint && npm run format:check",
    "version": "npm run changelog"
  },
  "dependencies": {
    "@rwh/keystrokes": "1.5.6",
    "balloons-js": "0.0.3",
    "clipboard": "2.0.11",
    "common-tags": "1.8.2",
    "cross-env": "10.1.0",
    "dayjs": "1.11.23",
    "emoji-blast": "0.12.0",
    "sweetalert2": "11.26.25"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "charts.css": "1.2.0",
    "conventional-changelog": "8.1.3",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "cz-git": "^1.14.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.2",
    "vite-plugin-html": "3.2.2",
    "vite-plugin-pwa": "2.0.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "glob": "^13.0.6",
    "micromatch": "^4.0.8"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "browserslist": {
    "development": [
      "last 1 version"
    ],
    "production": [
      "> 1%",
      "last 2 versions",
      "not ie <= 10"
    ]
  },
  "engines": {
    "node": ">= 24",
    "npm": ">= 11"
  },
  "packageManager": "npm@12.2.0",
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
